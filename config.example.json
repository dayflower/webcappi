{
  "listen": ":8080",
  "auth": {
    "bearer_token_file": "/run/secrets/webcappi/token"
  },
  "browser_path": "/opt/chrome/chrome",
  "no_sandbox": false,
  "work_dir": "/work/captures",
  "cache": {
    "backend": "memory"
  },
  "concurrency": 1,
  "queue_size": 8,
  "max_requests": 64,
  "capture_timeout_seconds": 30,
  "max_age_seconds": 60,
  "metadata_max_bytes": 1048576,
  "metadata_max_entries": 128,
  "max_width": 4096,
  "max_height": 4096,
  "max_pixels": 8388608,
  "resize_algorithm": "bilinear",
  "max_profile_bytes": 536870912,
  "max_post_bytes": 1048576,
  "max_png_bytes": 41943040,
  "profiles": {
    "default": {
      "user_data_dir": "/bundles/default/user-data",
      "profile_directory": "Default",
      "extensions": ["/bundles/default/extensions/my-extension"],
      "ready_selectors": ["#my-extension-ready"]
    }
  }
}
